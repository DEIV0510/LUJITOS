{
  "expo": {
    "name": "LUJITOS",
    "slug": "lujitos",
    "scheme": "lujitos",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14251F",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lujitos.finance"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14251F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
